def get_menu():
    try:
        response = requests.get(f"{base_url}/api/menu")
        response.raise_for_status()
        menu_dict = response.json()
        if menu_dict.get("success"):
            return menu_dict["data"]
        else:
            print(f"call_server failed with:", menu_dict.get("message"))
    except requests.exceptions.HTTPError as e:
        print(e.response.json())

def get_pantry():
    try:
        response = requests.get(f"{base_url}/api/custom")
        response.raise_for_status()
        pantry_dict = response.json()
        if pantry_dict.get("success"):
            return pantry_dict["data"]
        else:
            print(f"call_server failed with:", pantry_dict.get("message"))
    except requests.exceptions.HTTPError as e:
        print(e.response.json())

def create_menu_order():
    menu_ids = []
    menu = get_menu()
    for row in menu:
        menu_ids.append(row["menu_id"])
    selection = random.choice(menu_ids)
    return selection

