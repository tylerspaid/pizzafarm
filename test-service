function_dict = {
    'printdb': print_entire_db,
    'callserver': call_server
}

try:
    key_list = list(function_dict)
    user_input = input(f"What would you like to do? {key_list}]\n Execute function: ")
    if user_input in key_list:
        execute_function = function_dict[user_input]
        execute_function()
