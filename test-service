import psycopg2
import requests

base_url = 'http://localhost:3000';

connection_config = {
    "host": "localhost",
    "database": "pizzafarm",
    "user": "postgres",
    "password": "make-password-safe",
    "port": 5432
}

def direct_db_conn():
    with psycopg2.connect(**connection_config) as conn:
        with conn.cursor() as cursor:
            query = "SELECT * from *"
            cursor.execute(query)
            records = cursor.fetchall()
            for row in records:
                print(f"menu id: {row[0]} | name: {row[1]} | price: {row[2]}")
    cursor.close()
    conn.close()

def call_server():
    try:
        response = requests.get(f"{base_url}/api/menu")
        response.raise_for_status()
        payload = response.json()
        if payload.get("success"):
            return payload["data"]
        else:
            print(f"call_server failed with:", payload.get("message"))
    except requests.exceptions.HTTPError as e:
        print(e.response.json())

